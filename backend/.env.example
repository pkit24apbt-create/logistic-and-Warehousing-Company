# Copy this file to ".env" in the backend folder and fill in your own values.
# Never commit the real .env file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_safety
DB_USER=postgres
DB_PASSWORD=your_postgres_password

PORT=5000

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# The address the website runs on (used for CORS).
CLIENT_ORIGIN=http://localhost:5173